{
  "name": "youtube-ai-factory",
  "private": true,
  "packageManager": "pnpm@9.0.0",
"scripts": {
  "build": "nest build",
  "dev": "nest start --watch",
  "start": "node dist/main.js",
  "worker": "node dist/worker.js",
  "pipeline:run": "ts-node scripts/run-pipeline.ts",
  "pipeline:dry": "DRY_RUN=true ts-node scripts/run-pipeline.ts",
  "scheduler:start": "ts-node scripts/scheduler.ts",
  "seed-channel": "ts-node scripts/seed-channel.ts",
  "prisma:migrate": "prisma migrate deploy",
  "prisma:generate": "prisma generate",
  "test": "jest",
  "test:e2e": "jest --config jest.e2e.config.ts",
  "lint": "eslint \"src/**/*.ts\""
},
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google/generative-ai": "^0.21.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.13.2",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}