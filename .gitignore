# ─────────────────────────────────────────────────────────────
#  YouTube AI Factory — .gitignore
#  Node.js + TypeScript + NestJS + Prisma + FFmpeg pipeline
# ─────────────────────────────────────────────────────────────

# ────────────────  Dependencies  ────────────────
node_modules/
.pnpm-store/
.pnp
.pnp.js
.yarn/
.yarnrc.yml
package-lock.json
yarn.lock

# ────────────────  Build output  ────────────────
dist/
build/
out/
*.tsbuildinfo
.next/
.nuxt/
.cache/
.parcel-cache/
.eslintcache

# ────────────────  Environment & secrets  ────────────────
# NEVER commit real credentials.
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.p12
*.pfx
service-account*.json
sa.json
gcp-sa.json
credentials.json

# ────────────────  Prisma  ────────────────
# Keep migrations; ignore generated client & local dev artifacts.
# (Migrations ARE committed — they are source-of-truth schema.)
node_modules/.prisma/
prisma/*.db
prisma/*.db-journal
prisma/dev.db*
.prisma/

# ────────────────  Database dumps / local data  ────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
data/
pgdata/
dump.sql
*.dump

# ────────────────  Runtime storage  ────────────────
storage/
work/
tmp/
temp/
.video-cache/
renders/
output/
final/
audio/
scenes/
thumbnails/
videos/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PM2 runtime files
.pm2/
ecosystem.config.local.js

# ────────────────  Media (never commit generated media)  ────────────────
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.flv
*.wmv
*.m4v
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.bmp
*.tiff
*.srt
*.vtt
*.ass
*.ssa

# …EXCEPT keep static assets that are part of the codebase
!public/**/*.png
!public/**/*.jpg
!public/**/*.svg
!public/**/*.webp
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.svg
!assets/**/*.webp
!src/assets/**/*.png
!src/assets/**/*.jpg
!src/assets/**/*.svg
!src/assets/**/*.webp
!**/favicon.ico

# ────────────────  Google Cloud  ────────────────
.gcloud/
.gcloudignore
.credentials/
google-cloud-sdk/
application_default_credentials.json
gcs-key*.json

# ────────────────  YouTube / OAuth tokens  ────────────────
token.json
tokens.json
oauth-token.json
oauth2-token.json
youtube-token.json
refresh-token.txt
.youtube-token

# ────────────────  Testing & coverage  ────────────────
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
playwright-report/
.cypress/

# ────────────────  IDE / editor  ────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
!.vscode/launch.example.json
.idea/
*.iml
*.ipr
*.iws
.fleet/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace

# ────────────────  OS junk  ────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ────────────────  Docker (if used later)  ────────────────
.docker/
docker-compose.override.yml
*.tar
*.tar.gz

# ────────────────  Python virtualenv (some tooling uses it)  ────────────────
venv/
.venv/
env/
ENV/
*.egg-info/
__pycache__/
*.py[cod]

# ────────────────  Misc  ────────────────
.pnpm-debug.log
.node_repl_history
.vercel
.netlify
.eslintcache
stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ────────────────  Project-specific  ────────────────
# Local channel configs (may contain personal channel IDs) — keep example
config/channels/*.local.json
config/channels/*.secret.json

# Backup files we created during debugging
.env.bak
*.bak
*~
