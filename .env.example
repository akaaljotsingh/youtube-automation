cat > .env.example <<'EOF'
# ─────────────────────────────────────────────────────────────
#  YouTube AI Factory — environment template
#  Copy to .env and fill in real values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# ── Database ──
DATABASE_URL=postgresql://ytaf:CHANGE_ME@localhost:5432/ytaf

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Google Cloud ──
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket
# Absolute path to the service-account JSON. Keep it OUT of git.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/secrets/sa.json

# ── Gemini / Veo / TTS (from https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_RESOLUTION=720p
TTS_MODEL=gemini-3.1-flash-tts-preview

# ── YouTube OAuth (from Google Cloud Console → Credentials) ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Telegram alerts (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Runtime flags ──
DRY_RUN=true
AUTO_PUBLISH=false
WORKER_CONCURRENCY=2
EOF